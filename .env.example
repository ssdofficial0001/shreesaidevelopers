# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# SUPABASE PROJECT CONFIGURATION (Required)
# Connect to your existing Supabase project
# ==========================================
SUPABASE_URL=https://your-project-ref.supabase.co
# Use your service_role secret key (recommended for server-side inserts bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Or use your public anon key (ensure enquiries table has public insert policy)
SUPABASE_ANON_KEY=your_supabase_anon_key

# ==========================================
# EMAIL DELIVERY CONFIGURATION (Secondary Notification)
# Recipient: shreesaideveloper.in@gmail.com
# ==========================================

# Option 1: Gmail SMTP / Google Workspace (Recommended for zero-cost direct inbox delivery)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=shreesaideveloper.in@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
DESTINATION_EMAIL=shreesaideveloper.in@gmail.com

# Option 2: Resend API (Alternative fast transactional email service)
# RESEND_API_KEY=re_123456789

# Option 3: Web3Forms Access Key (Alternative form service)
# WEB3FORMS_ACCESS_KEY=your_web3forms_key

